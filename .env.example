# Evidence Tool local config

# Local SQLite database and upload folders
EVIDENCE_DB_PATH=./db/evidence.db
EVIDENCE_UPLOAD_DIR=./uploads

# Hash options: blake2b, sha256, md5
EVIDENCE_HASH_ALGO=blake2b

# Text extraction and AI batch behavior
# Start lower while testing; raise later for long reports/decks if your hardware can handle it.
EVIDENCE_EXTRACT_MAX_CHARS=40000
EVIDENCE_AI_MAX_CONSECUTIVE_ERRORS=3

# Optional image handling for Phase 2.
# When true, local image files (.jpg/.png/.webp/.tif/.tiff/.bmp) are attached to the Ollama chat request.
# Keep this enabled only for trusted/local Ollama endpoints and multimodal models.
EVIDENCE_AI_SEND_IMAGES=true
EVIDENCE_IMAGE_MAX_BYTES=10485760

# Ollama connection. Use one endpoint while testing to avoid duplicate slow retries.
# You may provide either a base URL or the full /api/chat URL.
OLLAMA_ENDPOINTS=http://localhost:11434/api/chat
OLLAMA_MODEL=gemma4:12b

# Thinking-capable models should generally use false for this batch summarization tool.
# Values: false, true, low, medium, high, or omit/auto.
OLLAMA_THINK=false

# Practical starting settings for document summaries.
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_PREDICT=4096
OLLAMA_TIMEOUT=300
OLLAMA_RETRIES=0
OLLAMA_RETRY_DELAY=3
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.05

# Increase this temporarily if you need more raw Ollama diagnostics in error logs.
OLLAMA_ERROR_RAW_CHARS=2500
