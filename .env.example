# Local database for scan inventory, categorization jobs, and AI results.
EVIDENCE_DB_PATH=db/evidence.db

# Where browser-uploaded files/folders are staged before scanning.
EVIDENCE_UPLOAD_DIR=uploads

# Hash algorithm for duplicate detection: blake2b, sha256, or md5.
# blake2b is the default because it is fast and modern. MD5 is supported if you prefer it.
EVIDENCE_HASH_ALGO=blake2b

# Maximum extracted text characters sent to Ollama per unique file.
EVIDENCE_EXTRACT_MAX_CHARS=20000

# Stop a categorization job after this many consecutive Ollama/API errors.
# This prevents the app from racing through thousands of files if a VPN/Tailscale/Ollama endpoint is down.
EVIDENCE_AI_MAX_CONSECUTIVE_ERRORS=3

# Same Ollama settings pattern as the irs990-tool.
OLLAMA_ENDPOINTS=http://localhost:11434/api/chat
OLLAMA_MODEL=
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200
OLLAMA_TIMEOUT=180

# Retries per file before it is marked as an Ollama/API error.
OLLAMA_RETRIES=2
OLLAMA_RETRY_DELAY=3
